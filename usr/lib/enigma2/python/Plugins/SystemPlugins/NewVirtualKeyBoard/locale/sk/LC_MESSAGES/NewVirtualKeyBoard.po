msgid ""
"\n"
"Press OK or Exit to abort!"
msgstr ""
"\n"
"Stlačte OK alebo Exit na zrušenie!"

#, python-format
msgid "%d languages downloaded"
msgstr "Stiahnuté jazyky: %d"

#, python-format
msgid "%d languages downloaded, %d failed"
msgstr "Stiahnuté jazyky: %d, zlyhalo: %d"

msgid "0-9 - Text input like on a phone, when the input field is selected"
msgstr "0-9 - Zadávanie textu ako na mobile, keď je vybrané vstupné pole"

msgid "All languages are installed"
msgstr "Všetky jazyky sú nainštalované"

msgid "All languages removed"
msgstr "Všetky jazyky boli odstránené"

msgid "Alt"
msgstr "Alt"

msgid "Background color"
msgstr "Farba pozadia"

msgid "Black"
msgstr "Čierna"

msgid "Blue - Shift"
msgstr "Modré - Shift"

msgid "Cancel"
msgstr "Zrušiť"

msgid "Cancel execution?"
msgstr "Zrušiť vykonávanie?"

msgid "Caps"
msgstr "Caps"

msgid "Clear"
msgstr "Zmazať"

msgid "Clear search history"
msgstr "Vymazať históriu vyhľadávania"

msgid "Console"
msgstr "Konzola"

msgid "Ctrl"
msgstr "Ctrl"

msgid "Default"
msgstr "Predvolené"

msgid "Delete the search history?"
msgstr "Vymazať históriu vyhľadávania?"

msgid "Do you want to install it now?"
msgstr "Chcete ho teraz nainštalovať?"

msgid "Download all"
msgstr "Stiahnuť všetky"

#, python-format
msgid "Download all %d missing languages?"
msgstr "Stiahnuť všetky chýbajúce jazyky (%d)?"

#, python-format
msgid "Downloading language %d of %d ..."
msgstr "Sťahuje sa jazyk %d z %d ..."

msgid "Enable/Disable Checking Online Update"
msgstr "Povoliť/Zakázať kontrolu online aktualizácií"

msgid "Enter"
msgstr "Enter"

#. TRANSLATORS: key caps of the on-screen keyboard - keep them as
#. short as the English ones, the keys are small
msgid "Esc"
msgstr "Esc"

msgid "Execution finished!!"
msgstr "Vykonávanie dokončené!!"

msgid "Execution progress:"
msgstr "Priebeh vykonávania:"

msgid "Exit"
msgstr "Koniec"

msgid "Exit - Close without taking the text"
msgstr "Exit - Zavrieť bez prevzatia textu"

msgid "Failed to download language, try later"
msgstr "Stiahnutie jazyka zlyhalo, skúste to neskôr"

msgid "Fast forward - Insert space"
msgstr "Pretáčanie vpred - Vložiť medzeru"

msgid "Font size (-10 to +30)"
msgstr "Veľkosť písma (-10 až +30)"

msgid "Green - Enter: confirm the text and close"
msgstr "Zelené - Enter: potvrdiť text a zavrieť"

msgid "Help"
msgstr "Pomocník"

msgid "Hide"
msgstr "Skryť"

msgid "Image virtual keyboard"
msgstr "Vstavaná virtuálna klávesnica image"

msgid "Info - Show this screen again"
msgstr "Info - Znova zobraziť túto obrazovku"

msgid "Install language"
msgstr "Inštalovať jazyk"

msgid "Installing last update, enigma will be started after install"
msgstr "Inštalácia poslednej aktualizácie, enigma sa spustí po inštalácii"

msgid "Keyboard layout selection"
msgstr "Výber rozloženia klávesnice"

msgid "Language downloaded successfully, exit from install"
msgstr "Jazyk úspešne stiahnutý, ukončenie inštalácie"

msgid "Language removed from installed package"
msgstr "Jazyk odstránený z nainštalovaného balíka"

msgid "Left"
msgstr "Vľavo"

msgid "Left / Right at the edge of the keyboard - Switch to the suggestions or the search history"
msgstr "Vľavo / Vpravo na okraji klávesnice - Prepnúť na návrhy alebo históriu vyhľadávania"

#, python-format
msgid "Loading the keyboard layout %s failed"
msgstr "Načítanie rozloženia klávesnice %s zlyhalo"

msgid "Menu - Settings, install languages, clear the search history"
msgstr "Menu - Nastavenia, inštalácia jazykov, vymazanie histórie vyhľadávania"

msgid "Mostly transparent"
msgstr "Prevažne priehľadné"

msgid "New Virtual Keyboard"
msgstr "Nová virtuálna klávesnica"

msgid "New Virtual Keyboard - Original code SamSamSam (e2iplayer). Contributors: mfaraj57 and Fairbird. Skin and amends: KiddaC"
msgstr "Nová virtuálna klávesnica - Pôvodný kód SamSamSam (e2iplayer). Prispievatelia: mfaraj57 a Fairbird. Skin a zmeny: KiddaC"

msgid "New Virtual Keyboard Settings"
msgstr "Nastavenia - Nová virtuálna klávesnica"

msgid "New version"
msgstr "Nová verzia"

#, python-format
msgid "NewVirtualKeyBoard  V %s"
msgstr "NewVirtualKeyBoard  V %s"

msgid "NewVirtualKeyBoard setup"
msgstr "Nastavenie NewVirtualKeyBoard"

msgid "No language is installed"
msgstr "Nie je nainštalovaný žiadny jazyk"

msgid "Numeric keypad"
msgstr "Numerická klávesnica"

msgid "Numeric keypad for numbers"
msgstr "Numerická klávesnica pre čísla"

msgid "OK - Type the selected key / take the selected suggestion or history entry"
msgstr "OK - Napísať vybraný kláves / prevziať vybraný návrh alebo položku histórie"

msgid "OK / GREEN - accept, EXIT - cancel"
msgstr "OK / ZELENÉ - prijať, EXIT - zrušiť"

msgid "PVR - Switch between keyboard, suggestions and search history"
msgstr "PVR - Prepínať medzi klávesnicou, návrhmi a históriou vyhľadávania"

msgid "Page Down - Clear input text"
msgstr "Page Down - Vymazať zadaný text"

msgid "Page Up - Insert space"
msgstr "Page Up - Vložiť medzeru"

msgid "Press ok to install language"
msgstr "Stlačte OK pre inštaláciu jazyka"

msgid "Press ok to remove language"
msgstr "Stlačte OK pre odstránenie jazyka"

msgid "Previous / Next - Switch between keyboard, suggestions and search history"
msgstr "Predchádzajúci / Ďalší - Prepínať medzi klávesnicou, návrhmi a históriou vyhľadávania"

msgid "Red - Backspace / in the search history: delete the entry"
msgstr "Červené - Backspace / v histórii vyhľadávania: zmazať položku"

msgid "Remember last search entry"
msgstr "Zapamätať posledné vyhľadávanie"

msgid "Remove all"
msgstr "Odstrániť všetky"

#, python-format
msgid "Remove all %d installed languages?"
msgstr "Odstrániť všetky nainštalované jazyky (%d)?"

msgid "Restart GUI"
msgstr "Reštartovať GUI"

msgid "Restart enigma2 to load new settings?"
msgstr "Reštartovať enigma2 pre načítanie nových nastavení?"

msgid "Rewind - Clear input text"
msgstr "Pretáčanie vzad - Vymazať zadaný text"

msgid "Right"
msgstr "Vpravo"

msgid "Save"
msgstr "Uložiť"

msgid "Search history"
msgstr "História vyhľadávania"

msgid "Search history entries (1-99999)"
msgstr "Počet položiek histórie vyhľadávania (1-99999)"

msgid "Semi-transparent"
msgstr "Polopriehľadné"

msgid "Setup virtual keyboard"
msgstr "Nastaviť virtuálnu klávesnicu"

msgid "Shift"
msgstr "Shift"

msgid "Show flags"
msgstr "Zobraziť vlajky"

msgid "Show plugin in Plugin Browser"
msgstr "Zobraziť plugin v prehliadači pluginov"

msgid "Show search history"
msgstr "Zobraziť históriu vyhľadávania"

msgid "Show suggestions"
msgstr "Zobraziť návrhy"

msgid "Suggestions"
msgstr "Návrhy"

msgid "Suggestions provider"
msgstr "Poskytovateľ návrhov"

msgid "Switching the keyboard failed"
msgstr "Prepnutie klávesnice zlyhalo"

msgid "Text - Switch language"
msgstr "Text - Prepnúť jazyk"

msgid "Text field alignment"
msgstr "Zarovnanie textového poľa"

msgid "Text input method-keyboard"
msgstr "Metóda vstupu textu - klávesnica"

msgid "The backup of the image keyboard is missing, the New Virtual Keyboard stays active."
msgstr "Chýba záloha vstavanej klávesnice image, Nová virtuálna klávesnica zostáva aktívna."

msgid "Transparent"
msgstr "Priehľadné"

msgid "Virtual Keyboard"
msgstr "Virtuálna klávesnica"

msgid "Yellow - AltGr"
msgstr "Žlté - AltGr"

msgid "is available"
msgstr "je k dispozícii"
