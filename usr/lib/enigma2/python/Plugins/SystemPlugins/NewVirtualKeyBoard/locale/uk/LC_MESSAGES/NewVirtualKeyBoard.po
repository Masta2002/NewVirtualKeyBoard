"\n"
"Press OK or Exit to abort!"
msgstr ""
"\n"
"Натисніть OK або Exit, щоб перервати!"

#, python-format
msgid "%d languages downloaded"
msgstr "Завантажено мов: %d"

#, python-format
msgid "%d languages downloaded, %d failed"
msgstr "Завантажено мов: %d, з помилкою: %d"

msgid "0-9 - Text input like on a phone, when the input field is selected"
msgstr "0-9 - Введення тексту як на телефоні, коли вибрано поле введення"

msgid "All languages are installed"
msgstr "Усі мови встановлено"

msgid "All languages removed"
msgstr "Усі мови видалено"

msgid "Alt"
msgstr "Alt"

msgid "Background color"
msgstr "Колір фону"

msgid "Black"
msgstr "Чорний"

msgid "Blue - Shift"
msgstr "Синя - Shift"

msgid "Cancel"
msgstr "Скасувати"

msgid "Cancel execution?"
msgstr "Перервати виконання?"

msgid "Caps"
msgstr "Caps"

msgid "Clear"
msgstr "Стерти"

msgid "Clear search history"
msgstr "Очистити історію пошуку"

msgid "Console"
msgstr "Консоль"

msgid "Ctrl"
msgstr "Ctrl"

msgid "Default"
msgstr "За замовчуванням"

msgid "Delete the search history?"
msgstr "Видалити історію пошуку?"

msgid "Do you want to install it now?"
msgstr "Встановити зараз?"

msgid "Download all"
msgstr "Завантажити всі"

#, python-format
msgid "Download all %d missing languages?"
msgstr "Завантажити всі відсутні мови (%d)?"

#, python-format
msgid "Downloading language %d of %d ..."
msgstr "Завантаження мови %d з %d ..."

msgid "Enable/Disable Checking Online Update"
msgstr "Увімкнути/вимкнути перевірку оновлень онлайн"

msgid "Enter"
msgstr "Enter"

#. TRANSLATORS: key caps of the on-screen keyboard - keep them as
#. short as the English ones, the keys are small
msgid "Esc"
msgstr "Esc"

msgid "Execution finished!!"
msgstr "Виконання завершено!!"

msgid "Execution progress:"
msgstr "Хід виконання:"

msgid "Exit"
msgstr "Вийти"

msgid "Exit - Close without taking the text"
msgstr "Exit - Закрити без перенесення тексту"

msgid "Failed to download language, try later"
msgstr "Не вдалося завантажити мову, спробуйте пізніше"

msgid "Fast forward - Insert space"
msgstr "Перемотування вперед - Вставити пробіл"

msgid "Font size (-10 to +30)"
msgstr "Розмір шрифту (від -10 до +30)"

msgid "Green - Enter: confirm the text and close"
msgstr "Зелена - Enter: підтвердити текст і закрити"

msgid "Help"
msgstr "Довідка"

msgid "Hide"
msgstr "Сховати"

msgid "Image virtual keyboard"
msgstr "Вбудована клавіатура образу"

msgid "Info - Show this screen again"
msgstr "Info - Показати цей екран ще раз"

msgid "Install language"
msgstr "Встановити мову"

msgid "Installing last update, enigma will be started after install"
msgstr "Встановлення останнього оновлення, після встановлення enigma буде запущено"

msgid "Keyboard layout selection"
msgstr "Вибір розкладки клавіатури"

msgid "Language downloaded successfully, exit from install"
msgstr "Мову успішно завантажено, вихід зі встановлення"

msgid "Language removed from installed package"
msgstr "Мову видалено зі встановленого пакета"

msgid "Left"
msgstr "Ліворуч"

msgid "Left / Right at the edge of the keyboard - Switch to the suggestions or the search history"
msgstr "Ліворуч / Праворуч на краю клавіатури - Перейти до підказок або історії пошуку"

#, python-format
msgid "Loading the keyboard layout %s failed"
msgstr "Не вдалося завантажити розкладку клавіатури %s"

msgid "Menu - Settings, install languages, clear the search history"
msgstr "Menu - Налаштування, встановлення мов, очищення історії пошуку"

msgid "Mostly transparent"
msgstr "Переважно прозорий"

msgid "New Virtual Keyboard"
msgstr "Нова віртуальна клавіатура"

msgid "New Virtual Keyboard - Original code SamSamSam (e2iplayer). Contributors: mfaraj57 and Fairbird. Skin and amends: KiddaC"
msgstr "Нова віртуальна клавіатура - Оригінальний код SamSamSam (e2iplayer). Учасники: mfaraj57 і Fairbird. Скін і доопрацювання: KiddaC"

msgid "New Virtual Keyboard Settings"
msgstr "Налаштування «Нова віртуальна клавіатура»"

msgid "New version"
msgstr "Нова версія"

#, python-format
msgid "NewVirtualKeyBoard  V %s"
msgstr "NewVirtualKeyBoard  V %s"

msgid "NewVirtualKeyBoard setup"
msgstr "Налаштування NewVirtualKeyBoard"

msgid "No language is installed"
msgstr "Жодної мови не встановлено"

msgid "Numeric keypad"
msgstr "Цифрова клавіатура"

msgid "Numeric keypad for numbers"
msgstr "Цифрова клавіатура для числових полів"

msgid "OK - Type the selected key / take the selected suggestion or history entry"
msgstr "OK - Ввести вибрану клавішу / взяти вибрану підказку або запис історії"

msgid "OK / GREEN - accept, EXIT - cancel"
msgstr "OK / ЗЕЛЕНА - прийняти, EXIT - скасувати"

msgid "PVR - Switch between keyboard, suggestions and search history"
msgstr "PVR - Перемикання між клавіатурою, підказками та історією пошуку"

msgid "Page Down - Clear input text"
msgstr "Page Down - Стерти введений текст"

msgid "Page Up - Insert space"
msgstr "Page Up - Вставити пробіл"

msgid "Press ok to install language"
msgstr "Натисніть OK, щоб встановити мову"

msgid "Press ok to remove language"
msgstr "Натисніть OK, щоб видалити мову"

msgid "Previous / Next - Switch between keyboard, suggestions and search history"
msgstr "Попередній / Наступний - Перемикання між клавіатурою, підказками та історією пошуку"

msgid "Red - Backspace / in the search history: delete the entry"
msgstr "Червона - Backspace / в історії пошуку: видалити запис"

msgid "Remember last search entry"
msgstr "Запам'ятовувати останній пошуковий запит"

msgid "Remove all"
msgstr "Видалити всі"

#, python-format
msgid "Remove all %d installed languages?"
msgstr "Видалити всі встановлені мови (%d)?"

msgid "Restart GUI"
msgstr "Перезапустити GUI"

msgid "Restart enigma2 to load new settings?"
msgstr "Перезапустити enigma2, щоб застосувати нові налаштування?"

msgid "Rewind - Clear input text"
msgstr "Перемотування назад - Стерти введений текст"

msgid "Right"
msgstr "Праворуч"

msgid "Save"
msgstr "Зберегти"

msgid "Search history"
msgstr "Історія пошуку"

msgid "Search history entries (1-99999)"
msgstr "Записів в історії пошуку (1-99999)"

msgid "Semi-transparent"
msgstr "Напівпрозорий"

msgid "Setup virtual keyboard"
msgstr "Налаштувати віртуальну клавіатуру"

msgid "Shift"
msgstr "Shift"

msgid "Show flags"
msgstr "Показувати прапори"

msgid "Show plugin in Plugin Browser"
msgstr "Показувати плагін у браузері плагінів"

msgid "Show search history"
msgstr "Показувати історію пошуку"

msgid "Show suggestions"
msgstr "Показувати підказки"

msgid "Suggestions"
msgstr "Підказки"

msgid "Suggestions provider"
msgstr "Постачальник підказок"

msgid "Switching the keyboard failed"
msgstr "Не вдалося перемкнути клавіатуру"

msgid "Text - Switch language"
msgstr "Text - Змінити мову"

msgid "Text field alignment"
msgstr "Вирівнювання текстового поля"

msgid "Text input method-keyboard"
msgstr "Метод введення тексту - клавіатура"

msgid "The backup of the image keyboard is missing, the New Virtual Keyboard stays active."
msgstr "Резервна копія вбудованої клавіатури образу відсутня, Нова віртуальна клавіатура залишається активною."

msgid "Transparent"
msgstr "Прозорий"

msgid "Virtual Keyboard"
msgstr "Віртуальна клавіатура"

msgid "Yellow - AltGr"
msgstr "Жовта - AltGr"

msgid "is available"
msgstr "доступна"
