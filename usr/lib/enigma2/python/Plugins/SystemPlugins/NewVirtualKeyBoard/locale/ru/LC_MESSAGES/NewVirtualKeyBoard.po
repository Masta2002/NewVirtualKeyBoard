msgstr "Почти прозрачный"

msgid "New Virtual Keyboard"
msgstr "Новая виртуальная клавиатура"

msgid "New Virtual Keyboard - Original code SamSamSam (e2iplayer). Contributors: mfaraj57 and Fairbird. Skin and amends: KiddaC"
msgstr "Новая виртуальная клавиатура — оригинальный код SamSamSam (e2iplayer). Разработчики: mfaraj57 и Fairbird. Скин и дополнения: KiddaC"

msgid "New Virtual Keyboard Settings"
msgstr "Настройки новой виртуальной клавиатуры"

msgid "New version"
msgstr "Новая версия"

#, python-format
msgid "NewVirtualKeyBoard  V %s"
msgstr "NewVirtualKeyBoard  V %s"

msgid "NewVirtualKeyBoard setup"
msgstr "Настройки NewVirtualKeyBoard"

msgid "No language is installed"
msgstr "Ни один язык не установлен"

