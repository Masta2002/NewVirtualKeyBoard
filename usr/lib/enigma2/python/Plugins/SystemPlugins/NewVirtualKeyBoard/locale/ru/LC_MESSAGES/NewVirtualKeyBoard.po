msgstr "PVR - Переключение между клавиатурой, подсказками и историей поиска"

msgid "Page Down - Clear input text"
msgstr "Page Down - Очистить введённый текст"

msgid "Page Up - Insert space"
msgstr "Page Up - Вставить пробел"

msgid "Press ok to install language"
msgstr "Нажмите OK, чтобы установить язык"

msgid "Press ok to remove language"
msgstr "Нажмите OK, чтобы удалить язык"

msgid "Previous / Next - Switch between keyboard, suggestions and search history"
msgstr "Назад / Вперёд - Переключение между клавиатурой, подсказками и историей поиска"

msgid "Red - Backspace / in the search history: delete the entry"
msgstr "Красная - Backspace / в истории поиска: удалить запись"

msgid "Remember last search entry"
msgstr "Запоминать последний поисковый запрос"

msgid "Remove all"
msgstr "Удалить все"

#, python-format
msgid "Remove all %d installed languages?"
msgstr "Удалить все установленные языки (%d)?"

msgid "Restart GUI"
msgstr "Перезапустить GUI"

msgid "Restart enigma2 to load new settings?"
msgstr "Перезапустить enigma2 для загрузки новых настроек?"

