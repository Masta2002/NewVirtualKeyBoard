msgstr "Записей в истории поиска (1-99999)"

msgid "Semi-transparent"
msgstr "Полупрозрачный"

msgid "Setup virtual keyboard"
msgstr "Настройка виртуальной клавиатуры"

msgid "Shift"
msgstr "Shift"

msgid "Show flags"
msgstr "Показывать флаги"

msgid "Show plugin in Plugin Browser"
msgstr "Показывать плагин в браузере плагинов"

msgid "Show search history"
msgstr "Показывать историю поиска"

msgid "Show suggestions"
msgstr "Показывать подсказки"

msgid "Suggestions"
msgstr "Подсказки"

msgid "Suggestions provider"
msgstr "Источник подсказок"

msgid "Switching the keyboard failed"
msgstr "Не удалось переключить клавиатуру"

msgid "Text - Switch language"
msgstr "Text - Сменить язык"

msgid "Text field alignment"
msgstr "Выравнивание текстового поля"

msgid "Text input method-keyboard"
msgstr "Клавиатура для ввода текста"

msgid "The backup of the image keyboard is missing, the New Virtual Keyboard stays active."
msgstr "Резервная копия встроенной клавиатуры имиджа отсутствует, новая виртуальная клавиатура остаётся активной."

msgid "Transparent"
msgstr "Прозрачный"

msgid "Virtual Keyboard"
msgstr "Виртуальная клавиатура"

msgid "Yellow - AltGr"
msgstr "Жёлтая - AltGr"

msgid "is available"
msgstr "доступна"
