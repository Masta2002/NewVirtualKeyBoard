msgstr "Configuración de Nuevo Teclado Virtual"

msgid "New version"
msgstr "Nueva versión"

#, python-format
msgid "NewVirtualKeyBoard  V %s"
msgstr "NewVirtualKeyBoard  V %s"

msgid "NewVirtualKeyBoard setup"
msgstr "Configuración de NewVirtualKeyBoard"

msgid "No language is installed"
