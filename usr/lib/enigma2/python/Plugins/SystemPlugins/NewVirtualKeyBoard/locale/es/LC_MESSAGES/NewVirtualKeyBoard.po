msgstr "Falta la copia de seguridad del teclado de la imagen, el Nuevo Teclado Virtual sigue activo."

msgid "Transparent"
msgstr "Transparente"

msgid "Virtual Keyboard"
msgstr "Teclado virtual"

msgid "Yellow - AltGr"
msgstr "Amarillo - AltGr"

msgid "is available"
msgstr "está disponible"
