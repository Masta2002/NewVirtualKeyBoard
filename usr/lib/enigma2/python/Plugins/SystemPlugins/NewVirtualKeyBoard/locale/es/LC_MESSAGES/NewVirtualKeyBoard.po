msgstr "OK - Escribir la tecla seleccionada / usar la sugerencia o entrada del historial seleccionada"

msgid "OK / GREEN - accept, EXIT - cancel"
msgstr "OK / VERDE - aceptar, EXIT - cancelar"

msgid "PVR - Switch between keyboard, suggestions and search history"
