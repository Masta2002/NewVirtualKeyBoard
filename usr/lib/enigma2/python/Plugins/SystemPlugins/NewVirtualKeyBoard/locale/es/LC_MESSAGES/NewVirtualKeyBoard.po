msgid "Page Up - Insert space"
msgstr "Page Up - Insertar espacio"

msgid "Press ok to install language"
msgstr "Pulse OK para instalar el idioma"

msgid "Press ok to remove language"
msgstr "Pulse OK para eliminar el idioma"

msgid "Previous / Next - Switch between keyboard, suggestions and search history"
msgstr "Anterior / Siguiente - Cambiar entre teclado, sugerencias e historial de búsqueda"

msgid "Red - Backspace / in the search history: delete the entry"
msgstr "Rojo - Retroceso / en el historial de búsqueda: eliminar la entrada"

msgid "Remember last search entry"
msgstr "Recordar la última búsqueda"

msgid "Remove all"
msgstr "Eliminar todos"

#, python-format
msgid "Remove all %d installed languages?"
msgstr "¿Eliminar todos los idiomas instalados (%d)?"

msgid "Restart GUI"
msgstr "Reiniciar GUI"

msgid "Restart enigma2 to load new settings?"
msgstr "¿Reiniciar enigma2 para cargar la nueva configuración?"

msgid "Rewind - Clear input text"
msgstr "Retroceso rápido - Borrar el texto introducido"

msgid "Right"
msgstr "Derecha"

msgid "Save"
msgstr "Guardar"

msgid "Search history"
msgstr "Historial de búsqueda"

msgid "Search history entries (1-99999)"
msgstr "Entradas del historial de búsqueda (1-99999)"

msgid "Semi-transparent"
msgstr "Semitransparente"

msgid "Setup virtual keyboard"
msgstr "Configurar teclado virtual"

msgid "Shift"
msgstr "Mayús"

msgid "Show flags"
msgstr "Mostrar banderas"

msgid "Show plugin in Plugin Browser"
msgstr "Mostrar el plugin en el navegador de plugins"

msgid "Show search history"
msgstr "Mostrar historial de búsqueda"

msgid "Show suggestions"
msgstr "Mostrar sugerencias"

msgid "Suggestions"
msgstr "Sugerencias"

msgid "Suggestions provider"
msgstr "Proveedor de sugerencias"

msgid "Switching the keyboard failed"
msgstr "No se pudo cambiar el teclado"

msgid "Text - Switch language"
msgstr "Text - Cambiar idioma"

msgid "Text field alignment"
msgstr "Alineación del campo de texto"

msgid "Text input method-keyboard"
msgstr "Método de entrada de texto - teclado"

