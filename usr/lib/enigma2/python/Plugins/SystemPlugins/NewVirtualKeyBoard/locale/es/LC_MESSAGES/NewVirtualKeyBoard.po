msgstr "Menu - Configuración, instalar idiomas, borrar el historial de búsqueda"

msgid "Mostly transparent"
msgstr "Casi transparente"

msgid "New Virtual Keyboard"
msgstr "Nuevo Teclado Virtual"

msgid "New Virtual Keyboard - Original code SamSamSam (e2iplayer). Contributors: mfaraj57 and Fairbird. Skin and amends: KiddaC"
msgstr "Nuevo Teclado Virtual - Código original SamSamSam (e2iplayer). Colaboradores: mfaraj57 y Fairbird. Skin y mejoras: KiddaC"

