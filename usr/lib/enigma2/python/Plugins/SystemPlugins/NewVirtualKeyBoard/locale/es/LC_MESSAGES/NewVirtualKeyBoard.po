msgstr "¡¡Ejecución finalizada!!"

msgid "Execution progress:"
msgstr "Progreso de la ejecución:"

msgid "Exit"
msgstr "Salir"

msgid "Exit - Close without taking the text"
msgstr "Exit - Cerrar sin aceptar el texto"

