msgstr "OK - Napsat vybranou klávesu / převzít vybraný návrh nebo položku historie"

msgid "OK / GREEN - accept, EXIT - cancel"
msgstr "OK / ZELENÁ - potvrdit, EXIT - zrušit"

msgid "PVR - Switch between keyboard, suggestions and search history"
msgstr "PVR - Přepínat mezi klávesnicí, návrhy a historií vyhledávání"

msgid "Page Down - Clear input text"
msgstr "Page Down - Vymazat zadaný text"

msgid "Page Up - Insert space"
msgstr "Page Up - Vložit mezeru"

msgid "Press ok to install language"
msgstr "Stiskněte OK pro instalaci jazyka"

msgid "Press ok to remove language"
msgstr "Stiskněte OK pro odebrání jazyka"

msgid "Previous / Next - Switch between keyboard, suggestions and search history"
msgstr "Předchozí / Další - Přepínat mezi klávesnicí, návrhy a historií vyhledávání"

msgid "Red - Backspace / in the search history: delete the entry"
msgstr "Červená - Backspace / v historii vyhledávání: smazat položku"

msgid "Remember last search entry"
msgstr "Pamatovat si poslední hledání"

msgid "Remove all"
msgstr "Odebrat vše"

#, python-format
msgid "Remove all %d installed languages?"
msgstr "Odebrat všechny nainstalované jazyky (%d)?"

msgid "Restart GUI"
msgstr "Restartovat GUI"

msgid "Restart enigma2 to load new settings?"
msgstr "Restartovat enigma2 pro načtení nových nastavení?"

msgid "Rewind - Clear input text"
msgstr "Přetočit zpět - Vymazat zadaný text"

msgid "Right"
msgstr "Vpravo"

msgid "Save"
msgstr "Uložit"

msgid "Search history"
msgstr "Historie vyhledávání"

