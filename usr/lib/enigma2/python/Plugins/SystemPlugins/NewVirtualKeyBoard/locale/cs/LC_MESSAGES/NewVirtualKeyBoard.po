msgstr "Převážně průhledné"

msgid "New Virtual Keyboard"
msgstr "Nová virtuální klávesnice"

msgid "New Virtual Keyboard - Original code SamSamSam (e2iplayer). Contributors: mfaraj57 and Fairbird. Skin and amends: KiddaC"
msgstr "Nová virtuální klávesnice - Původní kód SamSamSam (e2iplayer). Přispěvatelé: mfaraj57 a Fairbird. Skin a úpravy: KiddaC"

msgid "New Virtual Keyboard Settings"
msgstr "Nastavení Nové virtuální klávesnice"

msgid "New version"
msgstr "Nová verze"

#, python-format
msgid "NewVirtualKeyBoard  V %s"
msgstr "NewVirtualKeyBoard  V %s"

msgid "NewVirtualKeyBoard setup"
msgstr "Nastavení NewVirtualKeyBoard"

msgid "No language is installed"
