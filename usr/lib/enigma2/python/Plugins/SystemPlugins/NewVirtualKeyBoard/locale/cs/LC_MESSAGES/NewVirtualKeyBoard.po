msgstr "Návrhy"

msgid "Suggestions provider"
msgstr "Poskytovatel návrhů"

msgid "Switching the keyboard failed"
msgstr "Přepnutí klávesnice se nezdařilo"

msgid "Text - Switch language"
msgstr "Text - Přepnout jazyk"

msgid "Text field alignment"
msgstr "Zarovnání textového pole"

msgid "Text input method-keyboard"
msgstr "Metoda zadávání textu - klávesnice"

msgid "The backup of the image keyboard is missing, the New Virtual Keyboard stays active."
msgstr "Záloha klávesnice image chybí, Nová virtuální klávesnice zůstává aktivní."

msgid "Transparent"
msgstr "Průhledné"

msgid "Virtual Keyboard"
msgstr "Virtuální klávesnice"

msgid "Yellow - AltGr"
msgstr "Žlutá - AltGr"

msgid "is available"
msgstr "je k dispozici"
