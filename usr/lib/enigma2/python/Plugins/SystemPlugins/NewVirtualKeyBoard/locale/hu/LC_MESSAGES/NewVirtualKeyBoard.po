msgid ""
"\n"
"Press OK or Exit to abort!"
msgstr ""
"\n"
"Nyomja meg az OK vagy az Exit gombot a megszakításhoz!"

#, python-format
msgid "%d languages downloaded"
msgstr "%d nyelv letöltve"

#, python-format
msgid "%d languages downloaded, %d failed"
msgstr "%d nyelv letöltve, %d sikertelen"

msgid "0-9 - Text input like on a phone, when the input field is selected"
msgstr "0-9 - Szövegbevitel mint a telefonon, ha a beviteli mező ki van választva"

msgid "All languages are installed"
msgstr "Minden nyelv telepítve van"

msgid "All languages removed"
msgstr "Minden nyelv eltávolítva"

msgid "Alt"
msgstr "Alt"

msgid "Background color"
msgstr "Háttérszín"

msgid "Black"
msgstr "Fekete"

msgid "Blue - Shift"
msgstr "Kék - Shift"

msgid "Cancel"
msgstr "Mégsem"

msgid "Cancel execution?"
msgstr "Megszakítja a végrehajtást?"

msgid "Caps"
msgstr "Caps"

msgid "Clear"
msgstr "Töröl"

msgid "Clear search history"
msgstr "Keresési előzmények törlése"

msgid "Console"
msgstr "Konzol"

msgid "Ctrl"
msgstr "Ctrl"

msgid "Default"
msgstr "Alapértelmezett"

msgid "Delete the search history?"
msgstr "Törli a keresési előzményeket?"

msgid "Do you want to install it now?"
msgstr "Szeretné most telepíteni?"

msgid "Download all"
msgstr "Összes letöltése"

#, python-format
msgid "Download all %d missing languages?"
msgstr "Letölti mind a(z) %d hiányzó nyelvet?"

#, python-format
msgid "Downloading language %d of %d ..."
msgstr "Nyelv letöltése: %d / %d ..."

msgid "Enable/Disable Checking Online Update"
msgstr "Online frissítések ellenőrzésének engedélyezése/letiltása"

msgid "Enter"
msgstr "Enter"

#. TRANSLATORS: key caps of the on-screen keyboard - keep them as
#. short as the English ones, the keys are small
msgid "Esc"
msgstr "Esc"

msgid "Execution finished!!"
msgstr "Végrehajtás befejezve!!"

msgid "Execution progress:"
msgstr "Végrehajtás állapota:"

msgid "Exit"
msgstr "Kilép"

msgid "Exit - Close without taking the text"
msgstr "Exit - Bezárás a szöveg átvétele nélkül"

msgid "Failed to download language, try later"
msgstr "Nem sikerült letölteni a nyelvet, próbálja később"

msgid "Fast forward - Insert space"
msgstr "Előretekerés - Szóköz beszúrása"

msgid "Font size (-10 to +30)"
msgstr "Betűméret (-10 és +30 között)"

msgid "Green - Enter: confirm the text and close"
msgstr "Zöld - Enter: a szöveg jóváhagyása és bezárás"

msgid "Help"
msgstr "Súgó"

msgid "Hide"
msgstr "Elrejt"

msgid "Image virtual keyboard"
msgstr "Az image saját virtuális billentyűzete"

msgid "Info - Show this screen again"
msgstr "Infó - Képernyő újbóli megjelenítése"

msgid "Install language"
msgstr "Nyelv telepítése"

msgid "Installing last update, enigma will be started after install"
msgstr "Az utolsó frissítés telepítése, az Enigma a telepítés után indul el"

msgid "Keyboard layout selection"
msgstr "Billentyűzetkiosztás kiválasztása"

msgid "Language downloaded successfully, exit from install"
msgstr "Nyelv letöltése sikeres, kilépés a telepítésből"

msgid "Language removed from installed package"
msgstr "Nyelv eltávolítva a telepített csomagból"

msgid "Left"
msgstr "Bal"

msgid "Left / Right at the edge of the keyboard - Switch to the suggestions or the search history"
msgstr "Bal / Jobb a billentyűzet szélén - Váltás a javaslatokra vagy a keresési előzményekre"

#, python-format
msgid "Loading the keyboard layout %s failed"
msgstr "A(z) %s billentyűzetkiosztás betöltése sikertelen"

msgid "Menu - Settings, install languages, clear the search history"
msgstr "Menü - Beállítások, nyelvek telepítése, keresési előzmények törlése"

msgid "Mostly transparent"
msgstr "Többnyire átlátszó"

msgid "New Virtual Keyboard"
msgstr "Új virtuális billentyűzet"

msgid "New Virtual Keyboard - Original code SamSamSam (e2iplayer). Contributors: mfaraj57 and Fairbird. Skin and amends: KiddaC"
msgstr "Új virtuális billentyűzet - Eredeti kód: SamSamSam (e2iplayer). Közreműködők: mfaraj57 és Fairbird. Kinézet és módosítások: KiddaC"

msgid "New Virtual Keyboard Settings"
msgstr "Új virtuális billentyűzet beállításai"

msgid "New version"
msgstr "Új verzió"

#, python-format
msgid "NewVirtualKeyBoard  V %s"
msgstr "NewVirtualKeyBoard  V %s"

msgid "NewVirtualKeyBoard setup"
msgstr "NewVirtualKeyBoard beállítása"

msgid "No language is installed"
msgstr "Nincs telepített nyelv"

msgid "Numeric keypad"
msgstr "Numerikus billentyűzet"

msgid "Numeric keypad for numbers"
msgstr "Numerikus billentyűzet számmezőkhöz"

msgid "OK - Type the selected key / take the selected suggestion or history entry"
msgstr "OK - A kijelölt billentyű beírása / a kijelölt javaslat vagy előzmény átvétele"

msgid "OK / GREEN - accept, EXIT - cancel"
msgstr "OK / ZÖLD - elfogadás, EXIT - mégsem"

msgid "PVR - Switch between keyboard, suggestions and search history"
msgstr "PVR - Váltás a billentyűzet, a javaslatok és a keresési előzmények között"

msgid "Page Down - Clear input text"
msgstr "Page Down - Bevitt szöveg törlése"

msgid "Page Up - Insert space"
msgstr "Page Up - Szóköz beszúrása"

msgid "Press ok to install language"
msgstr "Nyomja meg az OK gombot a nyelv telepítéséhez"

msgid "Press ok to remove language"
msgstr "Nyomja meg az OK gombot a nyelv eltávolításához"

msgid "Previous / Next - Switch between keyboard, suggestions and search history"
msgstr "Előző / Következő - Váltás a billentyűzet, a javaslatok és a keresési előzmények között"

msgid "Red - Backspace / in the search history: delete the entry"
msgstr "Piros - Visszatörlés / a keresési előzményekben: a bejegyzés törlése"

msgid "Remember last search entry"
msgstr "Utolsó keresés megjegyzése"

msgid "Remove all"
msgstr "Összes eltávolítása"

#, python-format
msgid "Remove all %d installed languages?"
msgstr "Eltávolítja mind a(z) %d telepített nyelvet?"

msgid "Restart GUI"
msgstr "GUI újraindítása"

msgid "Restart enigma2 to load new settings?"
msgstr "Újraindítja az enigma2-t az új beállítások betöltéséhez?"

msgid "Rewind - Clear input text"
msgstr "Visszatekerés - Bevitt szöveg törlése"

msgid "Right"
msgstr "Jobb"

msgid "Save"
msgstr "Mentés"

msgid "Search history"
msgstr "Keresési előzmények"

msgid "Search history entries (1-99999)"
msgstr "Keresési előzmények száma (1-99999)"

msgid "Semi-transparent"
msgstr "Félig átlátszó"

msgid "Setup virtual keyboard"
msgstr "Virtuális billentyűzet beállítása"

msgid "Shift"
msgstr "Shift"

msgid "Show flags"
msgstr "Zászlók megjelenítése"

msgid "Show plugin in Plugin Browser"
msgstr "Bővítmény megjelenítése a bővítményböngészőben"

msgid "Show search history"
msgstr "Keresési előzmények megjelenítése"

msgid "Show suggestions"
msgstr "Javaslatok megjelenítése"

msgid "Suggestions"
msgstr "Javaslatok"

msgid "Suggestions provider"
msgstr "Javaslatok szolgáltatója"

msgid "Switching the keyboard failed"
msgstr "A billentyűzet váltása sikertelen"

msgid "Text - Switch language"
msgstr "Text - Nyelvváltás"

msgid "Text field alignment"
msgstr "Szövegmező igazítása"

msgid "Text input method-keyboard"
msgstr "Szövegbeviteli módszer - billentyűzet"

msgid "The backup of the image keyboard is missing, the New Virtual Keyboard stays active."
msgstr "Az image billentyűzetének biztonsági mentése hiányzik, az Új virtuális billentyűzet aktív marad."

msgid "Transparent"
msgstr "Átlátszó"

msgid "Virtual Keyboard"
msgstr "Virtuális billentyűzet"

msgid "Yellow - AltGr"
msgstr "Sárga - AltGr"

msgid "is available"
msgstr "elérhető"
