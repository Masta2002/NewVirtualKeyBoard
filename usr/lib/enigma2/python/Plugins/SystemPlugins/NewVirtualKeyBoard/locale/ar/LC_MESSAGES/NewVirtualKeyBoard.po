msgstr "Esc"

msgid "Execution finished!!"
msgstr "انتهى التنفيذ!!"

msgid "Execution progress:"
msgstr "تقدم التنفيذ:"

msgid "Exit"
msgstr "خروج"

msgid "Exit - Close without taking the text"
