msgid "Rewind - Clear input text"
msgstr "ترجيع - مسح نص الإدخال"

msgid "Right"
msgstr "يمين"

msgid "Save"
msgstr "حفظ"

msgid "Search history"
msgstr "سجل البحث"

msgid "Search history entries (1-99999)"
msgstr "عدد إدخالات سجل البحث (1-99999)"

msgid "Semi-transparent"
msgstr "شبه شفاف"

msgid "Setup virtual keyboard"
msgstr "إعداد لوحة المفاتيح الافتراضية"

msgid "Shift"
msgstr "Shift"

msgid "Show flags"
msgstr "عرض الأعلام"

msgid "Show plugin in Plugin Browser"
msgstr "عرض الإضافة في متصفح الإضافات"

msgid "Show search history"
msgstr "عرض سجل البحث"

msgid "Show suggestions"
msgstr "عرض الاقتراحات"

msgid "Suggestions"
msgstr "الاقتراحات"

msgid "Suggestions provider"
msgstr "مزود الاقتراحات"

msgid "Switching the keyboard failed"
msgstr "فشل تبديل لوحة المفاتيح"

msgid "Text - Switch language"
msgstr "Text - تغيير اللغة"

msgid "Text field alignment"
msgstr "محاذاة حقل النص"

msgid "Text input method-keyboard"
msgstr "طريقة إدخال النص - لوحة المفاتيح"

msgid "The backup of the image keyboard is missing, the New Virtual Keyboard stays active."
msgstr "النسخة الاحتياطية للوحة مفاتيح النظام مفقودة، ستبقى لوحة المفاتيح الافتراضية الجديدة مفعلة."

msgid "Transparent"
msgstr "شفاف"

msgid "Virtual Keyboard"
msgstr "لوحة المفاتيح الافتراضية"

msgid "Yellow - AltGr"
msgstr "أصفر - AltGr"

msgid "is available"
msgstr "متوفر"
