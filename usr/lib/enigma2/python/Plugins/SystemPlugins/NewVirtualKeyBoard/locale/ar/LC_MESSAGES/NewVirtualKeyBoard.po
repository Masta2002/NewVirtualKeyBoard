msgstr "Menu - الإعدادات، تثبيت اللغات، مسح سجل البحث"

msgid "Mostly transparent"
msgstr "شفاف في الغالب"

msgid "New Virtual Keyboard"
msgstr "لوحة مفاتيح افتراضية جديدة"

msgid "New Virtual Keyboard - Original code SamSamSam (e2iplayer). Contributors: mfaraj57 and Fairbird. Skin and amends: KiddaC"
msgstr "لوحة مفاتيح افتراضية جديدة - الكود الأصلي SamSamSam (e2iplayer). المساهمون: mfaraj57 وFairbird. التصميم والتعديلات: KiddaC"

msgid "New Virtual Keyboard Settings"
msgstr "إعدادات لوحة المفاتيح الافتراضية الجديدة"

msgid "New version"
msgstr "إصدار جديد"

#, python-format
msgid "NewVirtualKeyBoard  V %s"
msgstr "NewVirtualKeyBoard  V %s"

msgid "NewVirtualKeyBoard setup"
msgstr "إعدادات NewVirtualKeyBoard"

msgid "No language is installed"
msgstr "لا توجد لغة مثبتة"

msgid "Numeric keypad"
msgstr "لوحة الأرقام"

msgid "Numeric keypad for numbers"
msgstr "لوحة الأرقام للحقول الرقمية"

msgid "OK - Type the selected key / take the selected suggestion or history entry"
msgstr "OK - كتابة المفتاح المحدد / اعتماد الاقتراح أو إدخال السجل المحدد"

msgid "OK / GREEN - accept, EXIT - cancel"
msgstr "OK / الأخضر - قبول، EXIT - إلغاء"

msgid "PVR - Switch between keyboard, suggestions and search history"
msgstr "PVR - التبديل بين لوحة المفاتيح والاقتراحات وسجل البحث"

msgid "Page Down - Clear input text"
msgstr "صفحة لأسفل - مسح نص الإدخال"

msgid "Page Up - Insert space"
msgstr "صفحة لأعلى - إضافة مسافة"

msgid "Press ok to install language"
msgstr "اضغط موافق لتثبيت اللغة"

msgid "Press ok to remove language"
msgstr "اضغط موافق لإزالة اللغة"

msgid "Previous / Next - Switch between keyboard, suggestions and search history"
msgstr "السابق / التالي - التبديل بين لوحة المفاتيح والاقتراحات وسجل البحث"

msgid "Red - Backspace / in the search history: delete the entry"
msgstr "أحمر - حذف للخلف / في سجل البحث: حذف الإدخال"

msgid "Remember last search entry"
msgstr "تذكر آخر عملية بحث"

msgid "Remove all"
msgstr "إزالة الكل"

#, python-format
msgid "Remove all %d installed languages?"
msgstr "إزالة جميع اللغات المثبتة (%d)؟"

msgid "Restart GUI"
msgstr "إعادة تشغيل الواجهة"

msgid "Restart enigma2 to load new settings?"
